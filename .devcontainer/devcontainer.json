{
  "name": "Mercedes-Benz data science",
  "build": {"dockerfile": "../docker/Dockerfile", "context": "..", "target": "lab"},
  "overrideCommand": true,
  "remoteUser": "researcher",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "containerEnv": {"MERCEDES_DATA_DIR": "/data"},
  "mounts": ["source=${localEnv:MERCEDES_DATA_DIR},target=/data,type=bind,readonly"],
  "customizations": {"vscode": {"extensions": ["ms-python.python", "ms-toolsai.jupyter"], "settings": {"python.defaultInterpreterPath": "/opt/venv/bin/python", "python.terminal.activateEnvironment": false}}}
}
